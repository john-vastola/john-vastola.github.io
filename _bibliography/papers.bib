@ARTICLE{clrev,
       author = {John J. Vastola and Andrew Saxe and Christopher Summerfield and Kanaka Rajan},
        title = "{Curriculum learning in brains and machines}",
                journal = {Submitted to {N}ature {R}eviews {N}euroscience},
     keywords = {submitted},
         year = 2026,
         abstract={Teaching students and non-human animals to perform complex tasks usually involves structured curricula. Teachers may give students a series of tasks that increase in difficulty or complexity, or perhaps which encourage them to learn specific skills that can be reused to solve future problems. But although the idea of using structured training to improve learning is obvious and widely used, curriculum learning (CL) remains surprisingly poorly understood. In machine learning, where optimizing learning has received sustained empirical and theoretical attention, curricula have only sometimes proved useful. Fundamental questions regarding when curricula are useful, whether good curricula should go from easy to hard, and how to define and determine optimal curricula lack general-purpose answers. Here, we synthesize evidence from across neuroscience, psychology, and artificial intelligence to propose a tentative framework for thinking about when and why curricula are effective. Motivated especially by a geometric picture of learning dynamics, we argue that good curricula should involve informative learning signals and performance-sensitive difficulty modulation, and should reorganize the representational geometry of learners (e.g., to support compositionality). We illustrate our points using concrete examples from animal and machine learning. Taken seriously, this perspective suggests a route towards practical and effective curriculum learning.}
}














@article{vastola_storing_2025,
	title = {Storing long-lived memories via molecular error correction: a minimal mathematical model of {Crick}’s memory switch},
	url = {https://www.biorxiv.org/content/early/2025/11/13/2025.11.13.688304},
	doi = {10.1101/2025.11.13.688304},
	abstract = {Molecular memory storage mechanisms face two serious obstacles: they must be robust to the intrinsic noise characteristic of molecular-scale processes, and they must rely on components (like proteins) whose effective lifetimes are limited for biophysical reasons. For example, if one stores a memory by attaching a post-translational ‘mark’ to a protein, naively the lifetime of that memory is limited by protein turnover and ambient demarking activity. In this work, we investigate the principles of persistent and noise-robust molecular memory by studying simple mathematical models of protein-marking-state-based memory switches. We pay special attention to two possible strategies for improving memory storage: effectively averaging over noise by using a large number of proteins, and an enzyme-based ‘error correction’ mechanism first proposed by Francis Crick. Through an exhaustive mathematical analysis of these models, which includes solving most of them exactly, we find that error correction provides an effective mechanism for storing long-lived memories, and that using large populations of proteins only slightly improves the lifetime of stored memories. But we also find that error correction is not always useful, since too much of it can make the probability of false positives excessively high. Our findings lend credence to Crick’s proposal, and suggest motifs that may be exploited by potential intracellular memory storage mechanisms. Finally, in addressing these issues, we also provide general insight about how to define memory performance in the molecular setting, as well as associated notions like lifetime and capacity.},
	journal = {bioRxiv},
	publisher = {Cold Spring Harbor Laboratory},
	author = {John J. Vastola and Tejas Ramdas and Samuel J. Gershman},
	year = {2025},
	keywords = {submitted}
} 

